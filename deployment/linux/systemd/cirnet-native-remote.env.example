CIRNET_ENV=production
CIRNET_ALLOW_GUEST=false
CIRNET_REMOTE_READ_ONLY=false
CIRNET_DATABASE_URL=postgresql://cirnet-native@localhost/cirnet_native
CIRNET_TRUSTED_ORIGINS=https://lab.example.invalid
CIRNET_CONTRACTS_ROOT=/opt/cirnet/native/resources
CIRNET_HARDWARE_MODE=simulation
CIRNET_HARDWARE_GRPC_TARGET=unix:/run/cirnet-native-hardware/rpc.sock
CIRNET_SIMULATION_WORKERS=4
CIRNET_CAPTURE_DIR=/var/lib/cirnet-native/captures
